rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && myRole() == 'teacher';
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (isTeacher() || myRole() == 'admin');
    }

    // ── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
                    // Owner updates their own doc with field-level restrictions.
                    (request.auth.uid == userId
                    && !('role'   in request.resource.data.diff(resource.data).affectedKeys())
                    && !('status' in request.resource.data.diff(resource.data).affectedKeys())
                    && (!('lat' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.lat is number
                            && request.resource.data.lat >= -90
                            && request.resource.data.lat <= 90))
                    && (!('lng' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.lng is number
                            && request.resource.data.lng >= -180
                            && request.resource.data.lng <= 180))
                    && (!('fcmTokens' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.fcmTokens.size() <= 10))
                    // A parent may add themselves to a student's parentIds (max 2).
                    || (myRole() == 'parent'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds'])
                        && request.auth.uid in request.resource.data.parentIds
                        && request.resource.data.parentIds.size() <= 2)
                    // A teacher/admin may remove a parent from a student's parentIds.
                    || (isTeacherOrAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds'])
                        && request.resource.data.get('parentIds', []).size() < resource.data.get('parentIds', []).size())
                    // A teacher/admin may remove a student from a parent's children list.
                    || (isTeacherOrAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['children'])
                        && request.resource.data.get('children', []).size() < resource.data.get('children', []).size()));

      // Per-user notification inbox — only the owner can read/write.
      match /notifications/{notifId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

    }

    // ── Trips ────────────────────────────────────────────────────────────────
    // Cloud Function (onTripChatSync) maintains allMemberIds on every write.
    // Parents are matched via hasAny against their children[] array.

    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (!('allMemberIds' in resource.data)) ||
        request.auth.uid in resource.data.allMemberIds ||
        (myRole() == 'parent' &&
          resource.data.allMemberIds.hasAny(
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('children', [])
          ))
      );
      allow create, delete: if isAdmin();
      allow update: if isTeacherOrAdmin();

      // Geofence alerts — studentId MUST equal the caller's UID.
      match /alerts/{alertId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.studentId == request.auth.uid
                      && request.resource.data.studentId is string
                      && request.resource.data.distance is number;
        allow update: if isTeacherOrAdmin();
      }
    }

    // ── Chats ────────────────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read: if isSignedIn()
                  && (isAdmin() || request.auth.uid in resource.data.memberIds);
      allow write: if isAdmin();
      // Non-admin users may create DM chats where they are one of exactly 2 members.
      allow create: if isSignedIn()
                    && request.resource.data.type == 'dm'
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 2;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && (isAdmin() || request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds);
        allow create: if isSignedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ── Emergencies ──────────────────────────────────────────────────────────
    // Only the involved student, teachers, and admins can read emergencies.

    match /emergencies/{emergencyId} {
      allow read: if isSignedIn() && (
        isTeacherOrAdmin() ||
        request.auth.uid == resource.data.studentId
      );
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin()
                    || (isSignedIn()
                        && resource.data.studentId == request.auth.uid
                        && request.resource.data.status == 'resolved');
      allow delete: if isAdmin();
    }

    // ── Parent ↔ Student link requests ───────────────────────────────────────
    // Parent creates a pending request; student approves or rejects it.

    match /linkRequests/{reqId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.parentId
                      || request.auth.uid == resource.data.studentId
                      || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.parentId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && myRole() == 'parent';
      allow update: if isSignedIn()
                    && resource.data.studentId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status'])
                    && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }

    // ── Activity logs — admin read/write ────────────────────────────────────

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── QR attendance tokens — Cloud Functions only ──────────────────────────

    match /qrTokens/{tokenId} {
      allow read, write: if false;
    }

    // ── Rate-limit scratch space ─────────────────────────────────────────────

    match /_rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
