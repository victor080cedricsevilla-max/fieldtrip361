rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: owner can write, any authenticated user can read.
    // A wildcard must cover a whole path segment, so the filename is matched in
    // full and ownership is checked against it (the app writes "<uid>.jpg").
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Emergency sounds: owner can write/read/delete
    match /emergency_sounds/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == userId
                           && request.resource.size < 10 * 1024 * 1024;
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Blank waiver / medical-clearance forms an admin attaches to a trip.
    // Every signed-in user may download one; only admins may publish.
    match /trip_documents/{schoolId}/{tripId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && userRole() == 'admin'
                   && request.resource.size < 10 * 1024 * 1024;
      // Split from write: request.resource is null on delete, so a size check
      // here would silently deny every cleanup of a replaced template.
      allow delete: if request.auth != null && userRole() == 'admin';
    }

    // Filled-in, parent-signed forms uploaded by a student. Readable by the
    // student who owns it and by school staff reviewing it.
    match /document_submissions/{schoolId}/{userId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || userRole() == 'admin'
                      || userRole() == 'teacher');
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
