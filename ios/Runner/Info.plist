<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FieldTrip360</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>FieldTrip360</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Location permission strings (required even for foreground use) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FieldTrip360 needs your location to share live position with teachers and parents during a field trip.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>FieldTrip360 needs background location so geofence warnings and live tracking keep working even when the app is closed.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>FieldTrip360 needs background location so geofence warnings and live tracking keep working even when the app is closed.</string>
	<!-- Camera: QR attendance scanning (teacher) and photographing signed
	     waivers (student). iOS terminates the app outright if this is missing
	     when the camera is opened, so it is not optional. -->
	<key>NSCameraUsageDescription</key>
	<string>FieldTrip360 uses the camera to scan attendance QR codes and to photograph signed waiver and medical forms.</string>
	<!-- Photo library: choosing a profile photo, or picking an already-taken
	     photo or PDF of a signed form. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FieldTrip360 needs access to your photos so you can upload a profile picture or a photo of a signed form.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>FieldTrip360 saves downloaded trip forms to your photo library so you can print them.</string>
	<!-- Background modes required for continuous tracking + push messaging -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>
	<!-- Declaring the "processing" background mode above obliges iOS to be told
	     which task identifiers may run. This is the identifier
	     flutter_background_service registers. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.flutter.background.refresh</string>
	</array>
	<!-- url_launcher must declare the schemes it may open before iOS will
	     report them as available. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>mailto</string>
		<string>tel</string>
	</array>
</dict>
</plist>
