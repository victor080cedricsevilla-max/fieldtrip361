# FieldTrip360 — iOS pods.
#
# The deployment target is set here rather than left to Flutter's default so a
# fresh `pod install` on a Mac resolves the right versions first time:
#   mobile_scanner 7.x  → iOS 15.5
#   firebase-ios-sdk 11 → iOS 13
# The highest requirement wins, so 15.5.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously, slowing every build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Pods default to Flutter's minimum, which is lower than mobile_scanner
      # needs; without this the build fails on the pod, not on Runner.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # Intel Macs cannot build the arm64 simulator slice that Apple silicon
      # uses. Harmless on Apple silicon, required on an Intel MacBook.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'

      # Permissions are compiled in by permission_handler-style macros; these
      # keep the ones this app actually uses and strip the rest, which avoids
      # App Store rejections for undeclared permission APIs.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_LOCATION=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
